[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://core_logic/BulletEffect.cs" id="1"]

[node name="BulletEffect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1")
; 弹体场景（子弹）
ProjectileScenePath = "res://bin/bullet.tscn"
; 打出几发。正数 = 固定发数；子弹固定 10 发，不随攻击力变
ProjectileCount = 10
; 相邻两发之间最多错开多少毫秒（实际取 0~本值之间的随机数）
StaggerMaxMs = 100
; 每发命中时播放的音效槽位，对应 configs/music.ini 的 [sfx] 段。留空 = 不播（子弹不配命中音效）
ImpactSfxSlot = ""
; 命中音效音量（线性值，1 = 原音量）。槽位留空时这项不起作用
ImpactSfxVolume = 1.0
; 命中音效的声部数。槽位留空时这项不起作用
ImpactVoiceCount = 6
