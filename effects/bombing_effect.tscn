[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://core_logic/BulletEffect.cs" id="1"]

[node name="BombingEffect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1")
; 弹体场景（航弹）
ProjectileScenePath = "res://bin/bomb.tscn"
; 打出几发。0 表示用调用方传进来的数量，也就是攻击力
ProjectileCount = 0
; 相邻两发之间最多错开多少毫秒（实际取 0~本值之间的随机数）
StaggerMaxMs = 100
; 每发命中时播放的音效槽位，对应 configs/music.ini 的 [sfx] 段。留空 = 不播
ImpactSfxSlot = "dead"
; 命中音效音量（线性值，1 = 原音量）。弹数多时叠在一起会偏吵，可以调小
ImpactSfxVolume = 0.7
; 命中音效的声部数。多发弹体错开命中，声部少了后一声会掐掉前一声
ImpactVoiceCount = 6
