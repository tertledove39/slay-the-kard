[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://bin/Bullet.cs" id="1_shell"]
[ext_resource type="Texture2D" uid="uid://3nk21givfasd" path="res://assest/tank_projetile.png" id="2_shell"]

; 坦克炮弹弹体：与 bin/bullet.tscn / bin/bomb.tscn 结构相同，只是换了贴图。
; 弹道由 Bullet.cs 决定——从攻击者直线飞向目标，并让贴图的「上边」对准飞行方向。
; 若实机看到炮弹是倒着飞的，把下面 Sprite2D 的 rotation 改成 3.14159（转 180°）即可。
[node name="TankShell" type="Control"]
layout_mode = 3
anchor_left = -0.001
anchor_top = -0.004
anchor_right = 0.001
anchor_bottom = 0.004
offset_left = -0.39999998
offset_top = -0.39999986
offset_right = 0.39999998
offset_bottom = 0.39999986
grow_horizontal = 2
grow_vertical = 2
; 整体缩放（与子弹一致）
scale = Vector2(3, 3)
script = ExtResource("1_shell")
; 飞行缓动。0 = In（一直加速、不减速，到最快那一刻消失）——与航弹同一种手感
FlightEase = 0

[node name="Sprite2D" type="Sprite2D" parent="."]
; 贴图相对弹体中心的偏移
position = Vector2(1, 3.1666665)
; 贴图大小。坦克炮弹原图只有 3x9（比航弹的 10x14 更细更小），
; 所以要放得比航弹多得多才看得见：净尺寸 = 根 3 × 本值 2.7 ≈ 8.1，屏幕上约 24×73 像素。
; 嫌大嫌小改这里；若要转 180° 请在上面加一行 rotation = 3.14159
scale = Vector2(2.7, 2.7)
texture = ExtResource("2_shell")
