[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://bin/PauseMenu.cs" id="1"]

; 暂停菜单：整屏压暗 + 居中的一块面板（音量区 + 动作按钮）。
; 动作按钮由 PauseMenu.cs 在运行时按调用方给的 PauseAction 建，所以场景里只有容器。
; 战斗与世界地图共用这一个场景，见 bin/PauseMenu.cs。
[node name="PauseMenu" type="CanvasLayer"]
layer = 10
script = ExtResource("1")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.75)

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -260.0
offset_right = 300.0
offset_bottom = 260.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 24

[node name="Rows" type="VBoxContainer" parent="Panel/Margin"]
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Panel/Margin/Rows"]
text = "设置"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 32

[node name="VolumeTitle" type="Label" parent="Panel/Margin/Rows"]
text = "音量"
theme_override_font_sizes/font_size = 22

[node name="VolumeRows" type="VBoxContainer" parent="Panel/Margin/Rows"]
theme_override_constants/separation = 6

[node name="Actions" type="VBoxContainer" parent="Panel/Margin/Rows"]
theme_override_constants/separation = 10
